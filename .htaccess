# The Daily Star: Two extraordinary executions (/saudi-execution/)
# Optional. Used by Apache / LiteSpeed; nginx ignores it (see README.md for the nginx block).
# Uses only FileInfo-type directives. If the folder ever answers "500 Internal Server Error",
# the server does not allow these overrides: delete this file and the site still works.

# File types older servers may not know
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/xml .xml
AddType text/plain .txt
AddCharset utf-8 .html .js .css .txt .xml

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript image/svg+xml
</IfModule>

# Caching: the page always revalidates; assets keep a week (story.js is versioned in index.html)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|webp|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Development files in the repository are not part of the site
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tools/ - [R=404,L]
  RewriteRule (^|/)[^/]+\.(md|py)$ - [R=404,L]
  RewriteRule ^(vercel\.json|\.vercelignore|\.gitignore|\.gitattributes)$ - [R=404,L]
</IfModule>
